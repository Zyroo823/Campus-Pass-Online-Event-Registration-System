# ==============================================================================
# CampusPass Environment Configuration
# NFR-002, NFR-007: All environment variables documented and configurable
# ==============================================================================

# Application Port
PORT=3000

# Institution Branding (Shown once in the top header only)
SCHOOL_NAME="University of Cebu - LM Campus"

# Application Timezone (used for all datetime parsing, display, and deadline/started checks)
APP_TIMEZONE="Asia/Manila"

# Application URL (for CORS and self-referential links)
APP_URL="http://localhost:3000"

# JWT Secret for Session Authentication (NFR-002: min 32 chars)
JWT_SECRET="stlc-campus-pass-production-secret-key-super-secure-32chars"

# Database Configuration (MySQL 8 / MariaDB 10.4+ XAMPP compatible)
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="campus_events"

# Set to true to use standalone in-memory SQL engine (e.g. without local MySQL)
USE_EMULATED_DB=false

# Rate Limiting Configuration (testers can reduce these to verify rate limit behavior)
RATE_LIMIT_GLOBAL_MAX=120
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_EVENT_REGISTER_MAX=10
RATE_LIMIT_EVENT_MUTATE_MAX=30

# Currency Configuration (Informational only: PHP, USD, EUR, etc.)
CURRENCY_CODE="PHP"

# Seed Data Minimum Date for upcoming events (YYYY-MM-DD)
SEED_MIN_DATE="2026-10-19"

# Reverse Proxy Trust (set to true if running behind Nginx / Cloud Run / Heroku)
TRUST_PROXY=false

# Demo Mode: Set to true to display the "Demo Accounts" box on the sign-in screen and "Sample data" label
# Default is false. When false, test account credentials are kept hidden from the UI.
DEMO_MODE=false
